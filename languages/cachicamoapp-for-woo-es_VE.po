#. Plugin Name of the plugin
#: cachicamoapp-for-woo.php
msgid "Cachicamo App for WooCommerce"
msgstr "Cachicamo App para WooCommerce"

#. Plugin URI of the plugin
#: cachicamoapp-for-woo.php
msgid "https://cachicamo.app/"
msgstr "https://cachicamo.app/"

#. Description of the plugin
#: cachicamoapp-for-woo.php
msgid ""
"Synchronizes products, inventory and orders between a WooCommerce store and "
"Cachicamo App."
msgstr ""
"Sincroniza productos, inventario y pedidos entre una tienda WooCommerce y "
"Cachicamo."

#. Author of the plugin
#: cachicamoapp-for-woo.php
msgid "Cachicamo"
msgstr "Cachicamo"

#. translators: %s: plan expiration date.
#: src/Account/Status.php:117
#, php-format
