msgstr "Tu suscripción a Cachicamo tiene un pago pendiente; vence el %s."

#: src/Account/Status.php:128
msgid ""
"Your Cachicamo account is expired. Renew it at cachicamo.app to resume "
"syncing and invoicing."
msgstr ""
"Tu cuenta de Cachicamo ha vencido. Renuévala en cachicamo.app para reanudar "
"la sincronización y facturación."

